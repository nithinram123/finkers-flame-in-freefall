# Store the real key in Vercel Environment Variables or .env.local for local use.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional Google AI Studio backup for provider outages and rate limits.
GEMINI_API_KEY=

# Optional Anthropic configuration for deployments without a GroqCloud key.
ANTHROPIC_API_KEY=
# Optional project-specific Anthropic key. Takes precedence over ANTHROPIC_API_KEY.
NASASpaceAppAPIKey=
ANTHROPIC_MODEL=claude-haiku-5-5

