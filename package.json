{
  "name": "flame-in-freefall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "data": "node scripts/normalize.mjs && node scripts/build-neural.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run data && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src scripts tests *.json *.md *.html",
    "format:check": "prettier --check src scripts tests *.json *.md *.html"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.3.0"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "vite": "^7.2.0"
  }
}
