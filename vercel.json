{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/ask.js": { "includeFiles": "public/data/combustion.json", "maxDuration": 25 },
    "api/evidence.js": { "includeFiles": "public/data/combustion.json" }
  },
  "redirects": [{ "source": "/scenarios", "destination": "/scenario", "permanent": true }],
  "rewrites": [{ "source": "/((?!api/|assets/|data/).*)", "destination": "/index.html" }]
}
